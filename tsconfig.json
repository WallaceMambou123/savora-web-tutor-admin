// tsconfig.json

{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // DÉBUT DES MODIFICATIONS : Ajout des alias pour les dossiers clés
    "paths": {
      // Alias générique (pour le code directement sous src)
      "@/*": ["./src/*"], 
      
      // Nouvel alias pour le contexte (src/app/context)
      "@context/*": ["./src/app/context/*"],
      
      // Nouvel alias pour les composants (src/components)
      "@components/*": ["./src/components/*"]
    }
    // FIN DES MODIFICATIONS
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}